              "pm.test('Three posts with categories', function () { const posts = pm.response.json(); pm.expect(posts.length).to.equal(3); posts.forEach(function (post) { pm.expect(post.category.id).to.equal(post.categoryId); pm.expect(post.category.name).to.be.a('string'); }); });"
