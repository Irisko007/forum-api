{
  "name": "forum-api",
  "version": "1.0.0",
  "description": "Простий API для постів форуму",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "db:seed": "node --import tsx scripts/seed-posts.ts",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.17",
    "dotenv": "^18.0.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.7.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "prisma": "^8.0.0-rc.22",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
